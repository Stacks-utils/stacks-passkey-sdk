# Relay configuration (copy to .env — never commit .env)
PORT=8787
HOST=127.0.0.1
STACKS_NETWORK=testnet

# Required: shared secret clients must send as Authorization: Bearer <key>
# (legacy single-tenant mode — multi-tenant uses per-wallet spk_ keys)
RELAY_API_KEY=change-me-to-a-long-random-string

# Local dev only — allows starting without RELAY_API_KEY
# RELAY_ALLOW_INSECURE_LOCAL=true

# Platform registrar private key (factory/catalog deployer — ST3XHH...)
SPONSOR_PRIVATE_KEY_FILE=./sponsor.key

# Per-wallet sponsor derivation + session signing (required in production)
RELAY_MASTER_SECRET=change-me-long-random-master-secret
RELAY_SESSION_SECRET=change-me-long-random-session-secret
RELAY_AUTH_DOMAIN=localhost

# Admin emergency read-only access (optional)
RELAY_ADMIN_API_KEY=admin-dev-change-me

# Persist wallet tenants + hashed API keys
GAS_TANK_PATH=./data/gas-tank.json

# Local dev: store retrievable API keys for admin UI reveal (default on when NODE_ENV != production)
# RELAY_DEV_STORE_API_KEYS=true

# Only sponsor calls to these contract deployers (comma-separated addresses).
ALLOWED_CONTRACTS=ST3XHHZ1CXVCNYXK3FQ1FDGJ9NK6YBJBJK3FVY5KQ

# Universal adapter for catalog registration (testnet deployer address)
PASSKEY_DEPLOYER_ADDRESS=ST3XHHZ1CXVCNYXK3FQ1FDGJ9NK6YBJBJK3FVY5KQ
PASSKEY_ADAPTER_ADDRESS=ST3XHHZ1CXVCNYXK3FQ1FDGJ9NK6YBJBJK3FVY5KQ
PASSKEY_ADAPTER_NAME=passkey-adapter

PASSKEY_FACTORY_ADDRESS=ST3XHHZ1CXVCNYXK3FQ1FDGJ9NK6YBJBJK3FVY5KQ
PASSKEY_FACTORY_NAME=passkey-factory

# Optional separate key for register-contract txs (defaults to sponsor/registrar key)
# REGISTRAR_PRIVATE_KEY=
MAX_FEE_MICRO_STX=100000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
